# ===========================================
# DocBrain Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env with real keys.

# --- PostgreSQL (Neon - https://neon.tech) ---
# Create a free project, enable pgvector extension, copy the connection string
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>.neon.tech:5432/docbrain?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# --- Redis (Upstash - https://upstash.com) ---
# Create a free Redis database, copy the rediss:// URL
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# --- Gemini API (embeddings) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq API (LLM text generation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- JWT ---
JWT_SECRET=your_jwt_secret_256_bit_long_string_here

# --- Server ---
PORT=8080
UPLOAD_DIR=./uploads
